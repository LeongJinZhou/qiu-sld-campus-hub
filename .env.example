# ==========================================
# 1. UNIVERSITY STACK (PHP 8+ / PDO Dual-Driver)
# ==========================================
# Offline Local Fallback (SQLite)
DB_DRIVER=sqlite
DB_PATH=./database.sqlite

# Production Exabytes / cPanel MySQL (Uncomment when server access is granted)
# DB_DRIVER=mysql
# DB_HOST=exabytes-server-ip
# DB_NAME=university_db
# DB_USER=university_user
# DB_PASS=secret

# ==========================================
# 2. PERSONAL STACK (Next.js / Supabase / Cloud)
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ACCESS_TOKEN="your-supabase-access-token"

# ==========================================
# 3. MCP & AI TOOLING
# ==========================================
GITHUB_PERSONAL_ACCESS_TOKEN="your-github-pat"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
