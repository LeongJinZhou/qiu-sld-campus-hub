{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "paths": { "@react/*": ["./resources/react/*"], "@/*": ["./resources/js/*"] },
        "types": ["vite/client"]
    },
    "include": ["resources/react/**/*.ts", "resources/react/**/*.tsx", "resources/js/types/**/*.d.ts", "resources/js/lib/format.ts", "resources/js/lib/search.ts", "resources/js/lib/clone.ts", "resources/js/lib/proposal.ts", "resources/js/lib/tours.ts"]
}
