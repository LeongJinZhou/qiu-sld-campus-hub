    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "paths": { "@/*": ["./resources/js/*"] },
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue"]
